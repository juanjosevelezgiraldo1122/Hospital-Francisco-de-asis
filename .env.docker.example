# Copia este archivo a .env y cambia todas las claves antes de iniciar Docker.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
DB_PASSWORD=replace-with-a-different-long-random-app-password

# Proveedor de IA (opcional)
GEMINI_API_KEY=

# Google y Microsoft OAuth (opcionales; registra estas URLs en cada proveedor)
APP_ORIGIN=http://localhost:8080
OAUTH_REDIRECT_BASE=http://localhost:8080/api/auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Correo de recuperación (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Puertos publicados en tu computador
DB_PUBLISHED_PORT=3306
WEB_PUBLISHED_PORT=8080
